# Required ------------------------------------------------------------------
# Shlink base URL (or the full .../rest/v3/short-urls endpoint). If the proxy
# runs on the same Docker network as Shlink, use the internal address, e.g.
# http://shlink:8080 -- no TLS/public DNS round trip.
SHLINK_URL=
SHLINK_API_KEY=

# Recommended ----------------------------------------------------------------
# Only allow shortening of these URL prefixes (comma separated), e.g. your
# PrivateBin instance: https://bin.example.org/?
ALLOWED_URL_PREFIXES=
# Shared secret for the YOURLS API (min. 16 chars). Use with PrivateBin's
# server-side [yourls] proxy or other YOURLS clients.
YOURLS_SIGNATURE=

# Optional (defaults shown) ------------------------------------------------
# SHLINK_API_VERSION=3
# SHLINK_TIMEOUT=5
# SHLINK_MAX_VISITS=          # empty = unlimited (old versions used 100)
# SHLINK_TAGS=privatebin
# SHLINK_DOMAIN=
# SHLINK_CRAWLABLE=false
# SHLINK_FIND_IF_EXISTS=true
# CORS_ALLOW_ORIGINS=*        # or e.g. https://bin.example.org
# LINK_REQUIRES_SIGNATURE=false
# YOURLS_SIGNATURE_TTL=43200
# ALLOWED_URL_SCHEMES=http,https
# MAX_URL_LENGTH=8192
# WEB_CONCURRENCY=2
